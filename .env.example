# Gemini API Key for server-side speech synthesis and voice recommendation
GEMINI_API_KEY=

# Optional server configuration
PORT=3000

# Optional Firebase Web API key override (defaults to key in firebase-applet-config.json)
FIREBASE_WEB_API_KEY=

# Daily quota configurations
GEMINI_DAILY_FREE_LIMIT=200
GEMINI_USER_DAILY_LIMIT=40
